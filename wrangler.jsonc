{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mono-creative",
  "compatibility_date": "2026-10-15",
  "pages_build_output_dir": "./dist"
  // Set public vars CONTACT_ALLOWED_ORIGINS and TURNSTILE_SITE_KEY per environment.
  // Set TURNSTILE_SECRET_KEY, CONTACT_SIGNING_KEY and MAKE_WEBHOOK_URL as encrypted
  // Pages secrets, never as public frontend config. No CORS policy is needed.
  // (2026-10-19) R2 removed; Google Drive credentials are added when the backend is implemented.
}
